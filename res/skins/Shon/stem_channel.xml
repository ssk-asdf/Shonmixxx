<!-- Shon: one stem row. Name, level knob, mute. -->
<Template>
  <SetVariable name="StemGroup">[Channel<Variable name="ChanNum"/>_Stem<Variable name="StemNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>ShonStemRow</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>min,min</SizePolicy>
    <Children>
      <WidgetGroup><Size>12f,1min</Size></WidgetGroup>
      <StemLabel>
        <TooltipId>StemLabel</TooltipId>
        <ObjectName>ShonStemLabel</ObjectName>
        <Group><Variable name="Group"/></Group>
        <StemNum><Variable name="StemNum"/></StemNum>
        <Alignment>left</Alignment>
        <Elide>right</Elide>
        <Size>48f,30f</Size>
        <Text></Text>
      </StemLabel>
      <KnobComposed>
        <TooltipId>StemVolumeKnob</TooltipId>
        <Size>35f,30f</Size>
        <Knob>skin:/palemoon/knobs/knob_indicator_small_grey.svg</Knob>
        <BackPath>skin:/palemoon/knobs/knob_bg_small.svg</BackPath>
        <MinAngle>-130</MinAngle>
        <MaxAngle>130</MaxAngle>
        <KnobCenterYOffset>1.883</KnobCenterYOffset>
        <ArcUnipolar>true</ArcUnipolar>
        <ArcRadius>12.0</ArcRadius>
        <ArcColor>#9a9aa2</ArcColor>
        <ArcThickness>2</ArcThickness>
        <ArcRoundCaps>true</ArcRoundCaps>
        <Connection>
          <ConfigKey><Variable name="StemGroup"/>,volume</ConfigKey>
        </Connection>
      </KnobComposed>
      <WidgetGroup><Size>6f,1min</Size></WidgetGroup>
      <PushButton>
        <TooltipId>StemMuteButton</TooltipId>
        <ObjectName>ShonStemMute</ObjectName>
        <Size>24f,22f</Size>
        <NumberStates>2</NumberStates>
        <State><Number>0</Number><Text>M</Text></State>
        <State><Number>1</Number><Text>M</Text></State>
        <Connection>
          <ConfigKey><Variable name="StemGroup"/>,mute</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
      </PushButton>
      <WidgetGroup><Size>6f,1min</Size></WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
