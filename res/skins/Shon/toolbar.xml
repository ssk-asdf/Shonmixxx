<Template>
  <WidgetGroup>
    <ObjectName>ToolBar</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>e,min</SizePolicy>
    <Children>
      <!-- Shon: left half. Both halves use the Ignored size policy so they
           always get equal width, which keeps the logo exactly centered. -->
      <WidgetGroup>
        <ObjectName>ShonToolbarLeft</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>i,min</SizePolicy>
        <Children>
          <WidgetGroup><Size>8f,1min</Size></WidgetGroup>
          <PushButton>
            <TooltipId>maximize_library</TooltipId>
            <ObjectName>ShonNav</ObjectName>
            <Size>88f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>BIG LIBRARY</Text></State>
            <State><Number>1</Number><Text>BIG LIBRARY</Text></State>
            <Connection>
              <ConfigKey>[Skin],show_maximized_library</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>10f,1min</Size></WidgetGroup>
          <WidgetGroup><ObjectName>ShonToolbarDivider</ObjectName><Size>1f,16f</Size></WidgetGroup>
          <WidgetGroup><Size>10f,1min</Size></WidgetGroup>
          <WidgetGroup><!-- view toggles, regular library -->
            <Layout>horizontal</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>
          <PushButton>
            <TooltipId>show_waveforms</TooltipId>
            <ObjectName>ShonNav</ObjectName>
            <Size>76f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>WAVEFORMS</Text></State>
            <State><Number>1</Number><Text>WAVEFORMS</Text></State>
            <Connection>
              <ConfigKey>[Skin],show_waveforms</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <TooltipId>toggle_4decks</TooltipId>
            <ObjectName>ShonNav</ObjectName>
            <Size>60f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>4 DECKS</Text></State>
            <State><Number>1</Number><Text>4 DECKS</Text></State>
            <Connection>
              <ConfigKey persist="true">[Skin],show_4decks</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <TooltipId>show_mixer</TooltipId>
            <ObjectName>ShonNav</ObjectName>
            <Size>50f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>MIXER</Text></State>
            <State><Number>1</Number><Text>MIXER</Text></State>
            <Connection>
              <ConfigKey persist="true">[Skin],show_mixer</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <TooltipId>show_effects</TooltipId>
            <ObjectName>ShonNav</ObjectName>
            <Size>62f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>EFFECTS</Text></State>
            <State><Number>1</Number><Text>EFFECTS</Text></State>
            <Connection>
              <ConfigKey persist="true">[Skin],show_effectrack</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <TooltipId>show_samplers</TooltipId>
            <ObjectName>ShonNav</ObjectName>
            <Size>70f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>SAMPLERS</Text></State>
            <State><Number>1</Number><Text>SAMPLERS</Text></State>
            <Connection>
              <ConfigKey persist="true">[Skin],show_samplers</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <TooltipId>show_microphone</TooltipId>
            <ObjectName>ShonNav</ObjectName>
            <Size>64f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>MIC/AUX</Text></State>
            <State><Number>1</Number><Text>MIC/AUX</Text></State>
            <Connection>
              <ConfigKey persist="true">[Skin],show_microphones</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
            </Children>
            <Connection>
              <ConfigKey>[Skin],show_maximized_library</ConfigKey>
              <Transform><Not/></Transform>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>
          <WidgetGroup><!-- view toggles, big library -->
            <Layout>horizontal</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>
          <PushButton>
            <TooltipId>show_waveforms</TooltipId>
            <ObjectName>ShonNav</ObjectName>
            <Size>56f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>DECKS</Text></State>
            <State><Number>1</Number><Text>DECKS</Text></State>
            <Connection>
              <ConfigKey>[LateNight],max_lib_show_decks</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <TooltipId>toggle_4decks</TooltipId>
            <ObjectName>ShonNav</ObjectName>
            <Size>60f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number><Text>4 DECKS</Text></State>
            <State><Number>1</Number><Text>4 DECKS</Text></State>
            <Connection>
              <ConfigKey persist="true">[Skin],show_4decks</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
            </Children>
            <Connection>
              <ConfigKey>[Skin],show_maximized_library</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>
          <WidgetGroup><Size>0me,min</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>12f,min</Size></WidgetGroup>
      <Label>
        <ObjectName>ToolbarLogo</ObjectName>
        <Size>120f,36f</Size>
      </Label>
      <WidgetGroup><Size>12f,min</Size></WidgetGroup>

      <!-- Shon: right half. Modes, icon buttons, status, clock last. -->
      <WidgetGroup>
        <ObjectName>ShonToolbarRight</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>i,min</SizePolicy>
        <Children>
          <WidgetGroup><Size>0me,min</Size></WidgetGroup>
          <PushButton>
            <Tooltip>Away Mode: ShonDJ keeps a matched set going (Shift+W)</Tooltip>
            <ObjectName>ShonAwayButton</ObjectName>
            <Size>28f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number></State>
            <State><Number>1</Number></State>
            <Connection>
              <ConfigKey>[AutoDJ],shon_away_mode</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <Tooltip>Match: show only songs that fit the playing track (Ctrl+M)</Tooltip>
            <ObjectName>ShonMatchButton</ObjectName>
            <Size>28f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number></State>
            <State><Number>1</Number></State>
            <Connection>
              <ConfigKey>[Library],shon_show_matches</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <Tooltip>Add songs: paste a YouTube link or drop files in Music\Inbox. Stems are made for you.</Tooltip>
            <ObjectName>ShonAddButton</ObjectName>
            <Size>28f,24f</Size>
            <NumberStates>1</NumberStates>
            <State><Number>0</Number></State>
            <Connection>
              <ConfigKey>[Shon],import_window</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <Tooltip>Song requests: QR code and inbox</Tooltip>
            <ObjectName>ShonRequestsButton</ObjectName>
            <Size>28f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number></State>
            <State><Number>1</Number></State>
            <Connection>
              <ConfigKey>[Shon],requests_window</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <Tooltip>Phone remote. Left click: on or off. Right click: show the QR code.</Tooltip>
            <ObjectName>ShonPhoneButton</ObjectName>
            <Size>28f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number></State>
            <State><Number>1</Number></State>
            <Connection>
              <ConfigKey>[Shon],remote</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[Shon],remote_qr</ConfigKey>
              <ButtonState>RightButton</ButtonState>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>10f,1min</Size></WidgetGroup>
          <WidgetGroup><ObjectName>ShonToolbarDivider</ObjectName><Size>1f,16f</Size></WidgetGroup>
          <WidgetGroup><Size>10f,1min</Size></WidgetGroup>
          <PushButton>
            <TooltipId>toggle_recording</TooltipId>
            <ObjectName>ShonRecButton</ObjectName>
            <Size>28f,24f</Size>
            <NumberStates>3</NumberStates>
            <State><Number>0</Number></State><State><Number>1</Number></State><State><Number>2</Number></State>
            <Connection>
              <ConfigKey>[Recording],toggle_recording</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[Recording],status</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>
          <RecordingDuration>
            <ObjectName>ShonRecTime</ObjectName>
            <Size>52f,24f</Size>
            <InactiveText></InactiveText>
            <Alignment>left</Alignment>
            <Connection>
              <ConfigKey>[Recording],status</ConfigKey>
              <Transform><IsEqual>2</IsEqual></Transform>
              <BindProperty>visible</BindProperty>
            </Connection>
          </RecordingDuration>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <TooltipId>broadcast_enabled</TooltipId>
            <ObjectName>ShonAirButton</ObjectName>
            <Size>28f,24f</Size>
            <NumberStates>5</NumberStates>
            <State><Number>0</Number></State><State><Number>1</Number></State><State><Number>2</Number></State><State><Number>3</Number></State><State><Number>4</Number></State>
            <Connection>
              <ConfigKey>[Shoutcast],enabled</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[Shoutcast],status</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <Tooltip>Practice: score each transition (beats, phrase, blend length)</Tooltip>
            <ObjectName>ShonPracticeButton</ObjectName>
            <Size>28f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number></State><State><Number>1</Number></State>
            <Connection>
              <ConfigKey>[Shon],practice</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <Tooltip>Stealth mode: hide song names and covers (Ctrl+H). Hold right-click to peek.</Tooltip>
            <ObjectName>ShonStealthButton</ObjectName>
            <Size>28f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number></State>
            <State><Number>1</Number></State>
            <Connection>
              <ConfigKey>[Shon],stealth</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
            <Connection>
              <ConfigKey>[Shon],stealth_peek</ConfigKey>
              <ButtonState>RightButton</ButtonState>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
          <PushButton>
            <TooltipId>skin_settings</TooltipId>
            <ObjectName>ShonSettingsButton</ObjectName>
            <Size>28f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number></State><State><Number>1</Number></State>
            <Connection>
              <ConfigKey>[Skin],show_settings</ConfigKey>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>10f,1min</Size></WidgetGroup>
          <WidgetGroup><ObjectName>ShonToolbarDivider</ObjectName><Size>1f,16f</Size></WidgetGroup>
          <WidgetGroup><Size>10f,1min</Size></WidgetGroup>
          <StatusLight>
            <TooltipId>autodj_status</TooltipId>
            <ObjectName>AutoDjStatus</ObjectName>
            <Size>30f,22f</Size>
            <NumberPos>3</NumberPos>
            <PathStatusLight1>skin:/<Variable name="StyleScheme"/>/style/autodj_status.svg</PathStatusLight1>
            <PathStatusLight2>skin:/<Variable name="StyleScheme"/>/style/autodj_status.svg</PathStatusLight2>
            <PathStatusLight3>skin:/<Variable name="StyleScheme"/>/style/autodj_status.svg</PathStatusLight3>
            <Connection>
              <ConfigKey>[AutoDJ],enabled</ConfigKey>
            </Connection>
            <Connection>
              <ConfigKey>[AutoDJ],enabled</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </StatusLight>
          <!-- CPU load: a thin bar, details in the tooltip -->
          <WidgetGroup>
            <Layout>vertical</Layout>
            <Size>42f,24f</Size>
            <Children>
              <WidgetGroup><Size>1f,9f</Size></WidgetGroup>
              <WidgetGroup>
                <ObjectName>LatencyMeterBox</ObjectName>
                <Size>42f,6f</Size>
                <Layout>vertical</Layout>
                <Children>
                  <VuMeter>
                    <TooltipId>audio_latency_usage</TooltipId>
                    <Size>40f,4f</Size>
                    <PathBack>skin:/<Variable name="StyleScheme"/>/style/shon_cpu_bg.svg</PathBack>
                    <PathVu>skin:/<Variable name="StyleScheme"/>/style/shon_cpu_fg.svg</PathVu>
                    <Horizontal>true</Horizontal>
                    <PeakHoldSize>0</PeakHoldSize>
                    <PeakHoldTime>1000</PeakHoldTime>
                    <PeakFallTime>100</PeakFallTime>
                    <PeakFallStep>1</PeakFallStep>
                    <Connection>
                      <ConfigKey>[App],audio_latency_usage</ConfigKey>
                    </Connection>
                  </VuMeter>
                </Children>
                <Connection>
                  <ConfigKey>[App],audio_latency_overload</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
              </WidgetGroup>
              <WidgetGroup><Size>1f,9f</Size></WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup><Size>14f,1min</Size></WidgetGroup>
          <WidgetGroup>
            <ObjectName>BatteryBox</ObjectName>
            <Layout>horizontal</Layout>
            <Children>
              <Battery>
                <ObjectName>Battery</ObjectName>
                <Size>24,24</Size>
                <SizePolicy>f,f</SizePolicy>
                <PixmapCharged scalemode="STRETCH_ASPECT">skin:/<Variable name="StyleScheme"/>/style/batt/ic_battery_charged.svg</PixmapCharged>
                <NumberStates>8</NumberStates>
                <PixmapsCharging scalemode="STRETCH_ASPECT">skin:/<Variable name="StyleScheme"/>/style/batt/ic_battery_charging_%1.svg</PixmapsCharging>
                <PixmapsDischarging scalemode="STRETCH_ASPECT">skin:/<Variable name="StyleScheme"/>/style/batt/ic_battery_discharging_%1.svg</PixmapsDischarging>
              </Battery>
            </Children>
          </WidgetGroup>
          <WidgetGroup><Size>20f,1min</Size></WidgetGroup>
          <WidgetGroup>
            <ObjectName>ClockWidget</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>
              <Time>
                <TooltipId>time</TooltipId>
              </Time>
            </Children>
          </WidgetGroup>
          <WidgetGroup><Size>10f,1min</Size></WidgetGroup>
          <PushButton>
            <ObjectName>ShonFullscreenButton</ObjectName>
            <Tooltip>Full screen on or off (F11)</Tooltip>
            <Size>28f,24f</Size>
            <NumberStates>2</NumberStates>
            <State><Number>0</Number></State><State><Number>1</Number></State>
            <Connection>
              <ConfigKey>[Shon],fullscreen</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>
              <WidgetGroup><Size>2f,1min</Size></WidgetGroup>
              <PushButton>
                <ObjectName>ShonCloseButton</ObjectName>
                <Tooltip>Close ShonDJ</Tooltip>
                <Size>28f,24f</Size>
                <NumberStates>1</NumberStates>
                <State><Number>0</Number></State>
                <Connection>
                  <ConfigKey>[Shon],quit</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
            </Children>
            <Connection>
              <ConfigKey>[Shon],fullscreen</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>
          <WidgetGroup><Size>8f,1min</Size></WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
    <Connection>
      <ConfigKey>[Skin],show_waveforms</ConfigKey>
      <BindProperty>highlight</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
